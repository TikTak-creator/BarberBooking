@model List<Appointment>
@{ ViewData["Title"] = "Мои записи"; }
<section class="page-width account-page"><partial name="_AccountNav" /><div class="section-heading"><div><span class="tiny-caps text-primary">ЛИЧНЫЙ КАБИНЕТ</span><h1>Мои записи</h1><p class="muted">Только ваши визиты. Показываются последние 200 записей.</p></div><a href="/Booking" class="btn btn-primary rounded-pill">Новая запись <i class="bi bi-plus-lg ms-2"></i></a></div>
@if (Model.Count == 0) { <div class="empty-state"><i class="bi bi-calendar2-heart"></i><h2>Начнём с первого визита</h2><p>Выберите услугу и удобное время — талон появится здесь.</p><a href="/Booking" class="btn btn-primary rounded-pill">Записаться онлайн</a></div> }
else { <div class="visit-grid">@foreach (var row in Model) { <a class="visit-card" href="/Booking/Confirmation?code=@row.BookingCode"><div class="visit-card-top"><span class="tiny-caps">@row.BookingCode</span><span class="status-pill status-@((int)row.Status)">@StatusText.Name(row.Status)</span></div><h3>@row.ServiceNameSnapshot</h3><p>@row.Barber.FullName</p><div class="visit-date"><i class="bi bi-calendar2"></i> @row.AppointmentDate.ToString("dd MMMM yyyy") <span>· @row.StartTime.ToString(@"hh\:mm")</span></div><div class="visit-card-bottom"><strong>@row.Price.ToString("N0") сом</strong><span>Открыть талон <i class="bi bi-arrow-up-right"></i></span></div></a> }</div> }
</section>
