@{ ViewData["Title"] = "Новый пароль"; }
<section class="auth-card standalone"><span class="tiny-caps text-primary">ВАШ АККАУНТ</span><h1>Новый пароль</h1><p class="muted">Вставьте одноразовый код из письма или полученный у владельца. Новый пароль — от 12 символов, с цифрами, строчными и заглавными буквами.</p><div asp-validation-summary="All" class="validation-summary"></div><form asp-action="ResetPassword" method="post"><label for="userName">Логин</label><input id="userName" name="userName" type="text" class="form-control" required maxlength="40" autocomplete="off" />
<label for="token">Код восстановления</label><input id="token" name="token" type="text" class="form-control" required maxlength="3000" autocomplete="off" />
<label for="password">Новый пароль</label><input id="password" name="password" type="password" class="form-control" required maxlength="128" autocomplete="new-password" />
<label for="confirmPassword">Повторите пароль</label><input id="confirmPassword" name="confirmPassword" type="password" class="form-control" required maxlength="128" autocomplete="new-password" /><button class="btn btn-primary rounded-pill w-100 mt-4">Продолжить</button></form><a href="/Account/Login" class="d-block mt-4 text-center">Вернуться ко входу</a></section>
