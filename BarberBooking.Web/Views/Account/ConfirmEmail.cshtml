@{ ViewData["Title"] = "Подтвердить email"; }
<section class="auth-card standalone"><span class="tiny-caps text-primary">ВАШ АККАУНТ</span><h1>Подтвердить email</h1><p class="muted">Откройте письмо от салона и вставьте полученный код. Коды не нужно передавать сотрудникам.</p><div asp-validation-summary="All" class="validation-summary"></div><form asp-action="ConfirmEmail" method="post"><label for="userName">Логин</label><input id="userName" name="userName" type="text" class="form-control" required maxlength="40" autocomplete="off" />
<label for="token">Код из письма</label><input id="token" name="token" type="text" class="form-control" required maxlength="3000" autocomplete="off" /><button class="btn btn-primary rounded-pill w-100 mt-4">Продолжить</button></form><a href="/Account/Login" class="d-block mt-4 text-center">Вернуться ко входу</a></section>
