@model ApplicationUser
@{ ViewData["Title"] = "Безопасность"; bool enabled = ViewBag.Enabled; string? codes = ViewBag.Codes; }
<section class="page-width account-page"><partial name="_AccountNav" /><div class="section-heading"><div><span class="tiny-caps text-primary">ПОД ВАШИМ КОНТРОЛЕМ</span><h1>Безопасность аккаунта</h1></div></div>
@if (codes is not null) { <div class="recovery-box"><h2>Сохраните резервные коды</h2><p>Каждый работает один раз. Они показываются только сейчас. Храните отдельно от пароля и никому не передавайте.</p><pre>@codes</pre><button type="button" class="btn btn-outline-dark rounded-pill" data-download-codes>Скачать коды</button></div> }
<div class="settings-grid"><section class="panel-card"><span class="security-icon"><i class="bi bi-shield-check"></i></span><h2>Двухэтапный вход</h2><span class="status-pill @(enabled ? "status-2" : "status-0")">@(enabled ? "Включён" : "Не подключён")</span><p class="muted mt-3">После пароля вводите код из приложения-аутентификатора. Подходит любое приложение с TOTP, например Google Authenticator или Microsoft Authenticator.</p>
@if (!enabled) { <form asp-action="BeginTwoFactor" method="post"><label for="password">Подтвердите текущий пароль</label><input id="password" name="password" type="password" class="form-control" autocomplete="current-password" required maxlength="128" /><button class="btn btn-primary rounded-pill mt-4">Подключить приложение</button></form> }
else { <form asp-action="DisableTwoFactor" method="post" data-confirm="Отключить двухэтапный вход?"><label for="password">Текущий пароль</label><input id="password" name="password" type="password" class="form-control" autocomplete="current-password" required maxlength="128" /><label for="code">Код из приложения</label><input id="code" name="code" class="form-control" inputmode="numeric" autocomplete="one-time-code" required maxlength="8" /><button class="btn btn-outline-danger rounded-pill mt-4">Отключить двухэтапный вход</button></form> }
</section><aside class="panel-card soft-panel"><h2>Надёжный пароль</h2><p class="muted">Используйте уникальный пароль или парольную фразу. Не передавайте аккаунт коллегам — у каждого сотрудника должен быть свой вход.</p><a href="/Account/ChangePassword" class="btn btn-outline-primary rounded-pill">Изменить пароль</a><hr /><p class="muted small">Повторные ошибки входа временно блокируют попытки. При потере приложения используйте резервный код. Для владельца предусмотрено локальное восстановление на сервере.</p></aside></div></section>
