@{ ViewData["Title"] = "Восстановить доступ"; }
<section class="auth-card standalone"><span class="tiny-caps text-primary">ВАШ АККАУНТ</span><h1>Восстановить доступ</h1><p class="muted">Введите логин. Инструкция придёт на подтверждённый email, если салон настроил отправку почты. Без неё поможет администратор.</p><div asp-validation-summary="All" class="validation-summary"></div><form asp-action="ForgotPassword" method="post"><label for="userName">Логин</label><input id="userName" name="userName" type="text" class="form-control" required maxlength="40" autocomplete="off" /><button class="btn btn-primary rounded-pill w-100 mt-4">Продолжить</button></form><a href="/Account/Login" class="d-block mt-4 text-center">Вернуться ко входу</a></section>
