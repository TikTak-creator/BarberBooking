@model TwoFactorModel
@{ ViewData["Title"] = "Код подтверждения"; }
<section class="auth-card standalone"><span class="tiny-caps text-primary">ЕЩЁ ОДИН ШАГ</span><h1>Подтвердите вход</h1><p class="muted">Введите код из приложения-аутентификатора.</p><div asp-validation-summary="All" class="validation-summary"></div><form asp-action="TwoFactor" method="post"><input asp-for="ReturnUrl" type="hidden" /><input asp-for="RememberMe" type="hidden" /><label asp-for="Code">Код</label><input asp-for="Code" class="form-control" autofocus inputmode="numeric" autocomplete="one-time-code" required maxlength="8" /><button class="btn btn-primary rounded-pill w-100 mt-4">Войти</button></form>
<details class="mt-4"><summary>Нет доступа к приложению?</summary><form asp-action="RecoveryLogin" method="post"><label for="recovery">Резервный одноразовый код</label><input name="code" id="recovery" class="form-control" required maxlength="50" autocomplete="off" /><button class="btn btn-outline-dark rounded-pill mt-3">Войти с резервным кодом</button></form></details></section>
