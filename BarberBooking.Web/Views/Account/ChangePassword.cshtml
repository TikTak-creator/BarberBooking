@model PasswordModel
@{ ViewData["Title"] = "Изменить пароль"; }
<section class="auth-card standalone"><span class="tiny-caps text-primary">ВАША БЕЗОПАСНОСТЬ</span><h1>Новый пароль</h1><p class="muted">После смены остальные сеансы завершатся. Временный пароль сотрудника нужно заменить при первом входе.</p><div asp-validation-summary="All" class="validation-summary"></div>
<form asp-action="ChangePassword" method="post"><label asp-for="CurrentPassword">Текущий пароль</label><input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" required maxlength="128" />
<label asp-for="NewPassword">Новый пароль</label><input asp-for="NewPassword" class="form-control" autocomplete="new-password" required minlength="12" maxlength="128" />
<label asp-for="ConfirmPassword">Повторите новый пароль</label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" required maxlength="128" /><button class="btn btn-primary rounded-pill w-100 mt-4 py-3">Сохранить пароль</button></form></section>
