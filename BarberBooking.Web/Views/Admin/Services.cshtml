@model List<ServiceItem>
@{ ViewData["Title"]="Услуги и цены"; }
<div class="section-heading"><div><span class="tiny-caps text-primary">ВАШ ПРАЙС</span><h1>Услуги и стоимость</h1><p class="muted">Существующие записи сохраняют первоначальные цену и длительность.</p></div><a href="/admin/services/edit" class="btn btn-primary rounded-pill"><i class="bi bi-plus-lg me-2"></i>Добавить услугу</a></div><div class="table-card"><div class="table-responsive"><table class="table business-table"><thead><tr><th>Услуга</th><th>Категория</th><th>Длительность</th><th>Цена</th><th>Доступность</th><th></th></tr></thead><tbody>@foreach(var s in Model) { <tr><td><strong>@s.Name</strong></td><td>@s.Category</td><td>@s.DurationMinutes мин</td><td><strong>@s.Price.ToString("N2") сом</strong></td><td><span class="status-pill @(s.IsActive?"status-2":"status-4")">@(s.IsActive?"В каталоге":"В архиве")</span></td><td><a href="/admin/services/edit?id=@s.Id" class="btn btn-light rounded-pill">Изменить <i class="bi bi-arrow-up-right"></i></a></td></tr> }</tbody></table></div></div>
