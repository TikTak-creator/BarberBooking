@model BarberBooking.Web.Models.AdminDashboardViewModel
@{
    ViewData["Title"] = "Панель управления - Аналитика";
}

<div class="container-fluid px-lg-4 py-3">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h2 fw-extrabold text-dark mb-1">Аналитика и дашборд</h1>
            <p class="text-secondary mb-0">Сводные показатели барбершопа на @DateTime.Today.ToString("dd MMMM yyyy")</p>
        </div>
        <div class="d-flex gap-2">
            <div class="btn-group p-1 bg-white border rounded-pill shadow-xs" role="group">
                <a asp-action="Timeline" class="btn btn-sm btn-light rounded-pill px-3 fw-semibold text-secondary">
                    <i class="bi bi-kanban me-1"></i> Таймлайн
                </a>
                <a asp-action="Appointments" class="btn btn-sm btn-light rounded-pill px-3 fw-semibold text-secondary">
                    <i class="bi bi-table me-1"></i> Таблица
                </a>
                <a asp-action="Dashboard" class="btn btn-sm btn-primary rounded-pill px-3 fw-semibold active">
                    <i class="bi bi-graph-up me-1"></i> Аналитика
                </a>
            </div>
            <a asp-action="Timeline" class="btn btn-dark rounded-pill px-3 py-2 fw-semibold shadow-xs">
                <i class="bi bi-calendar2-range me-1"></i> К расписанию
            </a>
        </div>
    </div>

    <!-- Stat KPI Cards -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="small text-muted fw-bold text-uppercase">Записей сегодня</span>
                    <span class="badge bg-primary-subtle text-primary rounded-circle p-2">
                        <i class="bi bi-calendar-check fs-6"></i>
                    </span>
                </div>
                <div class="display-6 fw-extrabold text-dark mb-1">@Model.TodayAppointmentsCount</div>
                <div class="small text-success fw-semibold">
                    <i class="bi bi-arrow-up-right"></i> Активный рабочий день
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="stat-card">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="small text-muted fw-bold text-uppercase">Ожидаемая выручка</span>
                    <span class="badge bg-success-subtle text-success rounded-circle p-2">
                        <i class="bi bi-cash-stack fs-6"></i>
                    </span>
                </div>
                <div class="display-6 fw-extrabold text-dark mb-1">@Model.TodayRevenue.ToString("N0") <span class="fs-6 fw-normal text-muted">сом</span></div>
                <div class="small text-muted">По подтвержденным записям</div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="stat-card">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="small text-muted fw-bold text-uppercase">Ожидают подтверждения</span>
                    <span class="badge bg-warning-subtle text-warning rounded-circle p-2">
                        <i class="bi bi-hourglass-split fs-6"></i>
                    </span>
                </div>
                <div class="display-6 fw-extrabold text-dark mb-1">@Model.PendingCount</div>
                <div class="small text-secondary">Новые заявки с сайта</div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="stat-card">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="small text-muted fw-bold text-uppercase">Клиентская база</span>
                    <span class="badge bg-info-subtle text-info rounded-circle p-2">
                        <i class="bi bi-people fs-6"></i>
                    </span>
                </div>
                <div class="display-6 fw-extrabold text-dark mb-1">@Model.TotalClientsCount</div>
                <div class="small text-muted">Уникальных клиентов</div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Записи на сегодня -->
        <div class="col-lg-8">
            <div class="card border-0 bg-white rounded-4 shadow-sm p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-dark mb-0">Расписание на сегодня (@Model.TodayAppointments.Count)</h5>
                    <a asp-action="Timeline" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                        Открыть в календаре
                    </a>
                </div>

                @if (Model.TodayAppointments.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small text-muted">
                                <tr>
                                    <th>Код</th>
                                    <th>Время</th>
                                    <th>Клиент</th>
                                    <th>Мастер</th>
                                    <th>Услуга</th>
                                    <th>Сумма</th>
                                    <th>Статус</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var a in Model.TodayAppointments)
                                {
                                    <tr>
                                        <td><span class="badge bg-light text-dark border">@a.BookingCode</span></td>
                                        <td class="fw-bold">@a.TimeRange</td>
                                        <td>
                                            <div class="fw-semibold">@a.ClientName</div>
                                            <div class="small text-muted">@a.ClientPhone</div>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <img src="@a.BarberAvatar" alt="@a.BarberName" class="rounded-circle" style="width: 28px; height: 28px; object-fit: cover;" />
                                                <span>@a.BarberName</span>
                                            </div>
                                        </td>
                                        <td>@a.ServiceName</td>
                                        <td class="fw-bold">@a.Price.ToString("N0") сом</td>
                                        <td><span class="badge @a.StatusBadgeClass rounded-pill px-2 py-1">@a.StatusName</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-calendar-x fs-2 d-block mb-2"></i>
                        На сегодня записей нет
                    </div>
                }
            </div>
        </div>

        <!-- Популярные услуги и мастера -->
        <div class="col-lg-4">
            <div class="card border-0 bg-white rounded-4 shadow-sm p-4 mb-4">
                <h5 class="fw-bold text-dark mb-3">Активные мастера (@Model.ActiveBarbers.Count)</h5>
                <div class="d-flex flex-column gap-3">
                    @foreach (var b in Model.ActiveBarbers)
                    {
                        <div class="d-flex align-items-center justify-content-between p-2 rounded-3 border bg-light">
                            <div class="d-flex align-items-center gap-3">
                                <img src="@b.AvatarUrl" alt="@b.FullName" class="rounded-circle" style="width: 42px; height: 42px; object-fit: cover;" />
                                <div>
                                    <div class="fw-bold text-dark lh-sm">@b.FullName</div>
                                    <div class="small text-muted">@b.Title</div>
                                </div>
                            </div>
                            <span class="badge bg-warning text-dark rounded-pill">
                                <i class="bi bi-star-fill"></i> @b.Rating.ToString("F1")
                            </span>
                        </div>
                    }
                </div>
            </div>

            <div class="card border-0 bg-white rounded-4 shadow-sm p-4">
                <h5 class="fw-bold text-dark mb-3">Популярные услуги</h5>
                <ul class="list-group list-group-flush">
                    @foreach (var s in Model.PopularServices)
                    {
                        <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                            <div>
                                <div class="fw-semibold text-dark">@s.Name</div>
                                <div class="small text-muted">@s.DurationMinutes мин • @s.Category</div>
                            </div>
                            <span class="fw-bold text-primary">@s.Price.ToString("N0") сом</span>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>
