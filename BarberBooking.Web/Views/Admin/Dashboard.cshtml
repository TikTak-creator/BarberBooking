@model AdminDashboardViewModel
@inject BarberBooking.Web.Services.ShopClock Clock
@{ ViewData["Title"] = "Обзор дня"; var today = await Clock.NowAsync(); }
<div class="section-heading"><div><span class="tiny-caps text-primary">ПУЛЬС ВАШЕГО САЛОНА</span><h1>Хороший день начинается с порядка.</h1><p class="muted">@today.ToString("dddd, dd MMMM yyyy") · время салона</p></div><a href="/admin/timeline" class="btn btn-primary rounded-pill">Открыть расписание <i class="bi bi-arrow-up-right ms-2"></i></a></div>
<div class="metric-grid"><article class="metric-card blue"><span>Завершённые визиты · выручка</span><i class="bi bi-wallet2"></i><strong>@Model.TodayRevenue.ToString("N0")</strong><small>сом за сегодня · без ожидаемых оплат</small></article><article class="metric-card"><span>Записей сегодня</span><i class="bi bi-calendar2-check"></i><strong>@Model.TodayAppointmentsCount</strong><small>без отменённых</small></article><article class="metric-card"><span>Ожидают подтверждения</span><i class="bi bi-hourglass-split"></i><strong>@Model.PendingCount</strong><small>сегодня и позже</small></article><article class="metric-card"><span>Клиентов в истории</span><i class="bi bi-people"></i><strong>@Model.TotalClientsCount</strong><small>по уникальному телефону</small></article></div>
<div class="table-card"><header class="table-head"><h2>Сегодня в расписании</h2><a href="/admin/appointments" class="small">Весь журнал <i class="bi bi-arrow-right"></i></a></header>
@if (Model.TodayAppointments.Count == 0) { <div class="empty-state border-0"><i class="bi bi-calendar2"></i><h2>День пока свободен</h2><p>Новые заявки появятся в расписании. Можно добавить запись вручную.</p><a href="/admin/timeline" class="btn btn-outline-primary rounded-pill">Открыть календарь</a></div> }
else { <div class="table-responsive"><table class="table business-table"><thead><tr><th>Время</th><th>Клиент</th><th>Услуга / мастер</th><th>Сумма</th><th>Состояние</th></tr></thead><tbody>@foreach (var a in Model.TodayAppointments) { <tr><td><strong>@a.StartTime.ToString(@"hh\:mm")</strong><br /><small>@a.EndTime.ToString(@"hh\:mm")</small></td><td><strong>@a.ClientName</strong><br /><small>@a.ClientPhone</small></td><td><strong>@a.ServiceName</strong><br /><small>@a.BarberName</small></td><td>@a.Price.ToString("N0") сом</td><td><span class="status-pill status-@((int)a.Status)">@StatusText.Name(a.Status)</span></td></tr> }</tbody></table></div> }</div>
<div class="inline-notice"><i class="bi bi-info-circle me-2"></i> Выручка включает только визиты со статусом «Визит завершён». Это оперативный показатель, а не платёжный или бухгалтерский отчёт.</div>
