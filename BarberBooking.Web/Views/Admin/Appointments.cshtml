@model List<CalendarAppointmentDto>
@{ ViewData["Title"]="Журнал записей"; var manager=(bool)ViewBag.Manager; var barbers=(List<Barber>)ViewBag.Barbers; }
<div class="section-heading"><div><span class="tiny-caps text-primary">ИСТОРИЯ И ПЛАНЫ</span><h1>Журнал записей</h1><p class="muted">Период до 31 дня. Поиск по контактам — среди первых 1 000 записей периода, показано до 200 совпадений.</p></div></div>
<div asp-validation-summary="All" class="validation-summary"></div><form method="get" class="filter-bar"><div><label for="fromDate">С даты</label><input name="fromDate" id="fromDate" type="date" value="@ViewBag.FromDate" class="form-control" /></div><div><label for="toDate">По дату</label><input name="toDate" id="toDate" type="date" value="@ViewBag.ToDate" class="form-control" /></div><div><label for="barberId">Мастер</label><select name="barberId" id="barberId" class="form-select"><option value="">Все доступные</option>@foreach(var b in barbers) { <option value="@b.Id" selected="@(ViewBag.SelectedBarberId == b.Id)">@b.FullName</option> }</select></div><div><label for="status">Статус</label><select name="status" id="status" class="form-select"><option value="">Все состояния</option>@foreach(var status in Enum.GetValues<AppointmentStatus>()) { <option value="@((int)status)" selected="@(ViewBag.SelectedStatus == status)">@StatusText.Name(status)</option> }</select></div><div><label for="search">Поиск</label><input name="search" id="search" value="@ViewBag.Search" class="form-control" maxlength="100" placeholder="Имя, телефон, код" /></div><button class="btn btn-primary rounded-pill">Найти</button></form>
<div class="table-card"><div class="table-responsive"><table class="table business-table"><thead><tr><th>Дата / время</th><th>Клиент</th><th>Услуга / мастер</th><th>Состояние</th><th>Действие</th></tr></thead><tbody>@foreach(var a in Model) { <tr><td><strong>@a.Date.ToString("dd.MM.yyyy")</strong><br /><small>@a.TimeRange</small></td><td><strong>@a.ClientName</strong><br /><small>@a.ClientPhone</small><br /><small>@a.BookingCode</small></td><td><strong>@a.ServiceName</strong><br /><small>@a.BarberName · @a.Price.ToString("N0") сом</small></td><td><span class="status-pill status-@((int)a.Status)">@StatusText.Name(a.Status)</span></td><td><div class="row-actions">@foreach(var next in Enum.GetValues<AppointmentStatus>().Where(next=>BarberBooking.Web.Services.BookingService.CanTransition(a.Status,next) && (manager || next is AppointmentStatus.Completed or AppointmentStatus.NoShow))) { <form asp-action="UpdateStatus" method="post"><input name="id" type="hidden" value="@a.Id" /><input name="version" type="hidden" value="@a.Version" /><input name="status" type="hidden" value="@((int)next)" /><input name="returnUrl" type="hidden" value="@Context.Request.Path@Context.Request.QueryString" /><button class="btn btn-light rounded-pill">@StatusText.Name(next)</button></form> }</div></td></tr> }</tbody></table></div>@if(Model.Count==0) { <div class="empty-state border-0"><i class="bi bi-journal-text"></i><h2>Записей пока нет</h2><p>Измените период или критерии поиска.</p></div> }</div>
