@model ServiceItem
@{ ViewData["Title"]=Model.Id==0?"Новая услуга":"Редактировать услугу"; }
<div class="section-heading"><div><span class="tiny-caps text-primary">КАТАЛОГ</span><h1>@ViewData["Title"]</h1></div><a href="/admin/services" class="small">Назад к услугам</a></div><section class="panel-card form-panel"><div asp-validation-summary="All" class="validation-summary"></div><form asp-action="EditService" method="post"><input asp-for="Id" type="hidden" /><div class="form-grid"><div><label asp-for="Name">Название</label><input asp-for="Name" class="form-control" required maxlength="150" /></div><div><label asp-for="Category">Категория</label><input asp-for="Category" class="form-control" required maxlength="100" /></div><div class="full"><label asp-for="Description">Описание</label><textarea asp-for="Description" class="form-control" maxlength="500" rows="3"></textarea></div><div><label asp-for="Price">Цена, сом</label><input asp-for="Price" class="form-control" inputmode="decimal" required /></div><div><label asp-for="DurationMinutes">Длительность, минут</label><input asp-for="DurationMinutes" class="form-control" type="number" min="10" max="240" required /></div></div><label class="check-label my-4"><input asp-for="IsActive" /> Показывать в каталоге и принимать новые записи</label><button class="btn btn-primary rounded-pill">Сохранить услугу</button></form></section>
