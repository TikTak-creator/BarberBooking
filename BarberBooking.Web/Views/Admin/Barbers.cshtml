@model List<Barber>
@{ ViewData["Title"]="Мастера"; }
<div class="section-heading"><div><span class="tiny-caps text-primary">ЛЮДИ, КОТОРЫЕ СОЗДАЮТ СТИЛЬ</span><h1>Команда мастеров</h1><p class="muted">Настройте карточки и смены. Аккаунт для входа создаётся отдельно в разделе доступа.</p></div><a href="/admin/barbers/edit" class="btn btn-primary rounded-pill"><i class="bi bi-plus-lg me-2"></i>Добавить мастера</a></div>
<div class="table-card"><div class="table-responsive"><table class="table business-table"><thead><tr><th>Мастер</th><th>Рабочие дни</th><th>Смена</th><th>Состояние</th><th></th></tr></thead><tbody>@foreach(var b in Model) { <tr><td><strong>@b.FullName</strong><br /><small>@b.Title</small></td><td>@b.WorkingDays</td><td>@b.WorkStartTime.ToString(@"hh\:mm") – @b.WorkEndTime.ToString(@"hh\:mm")</td><td><span class="status-pill @(b.IsActive ? "status-2":"status-4")">@(b.IsActive?"Доступен":"В архиве")</span></td><td><a href="/admin/barbers/edit?id=@b.Id" class="btn btn-light rounded-pill">Изменить <i class="bi bi-arrow-up-right"></i></a></td></tr> }</tbody></table></div></div>
