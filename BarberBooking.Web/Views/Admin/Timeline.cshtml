@model ScheduleTimelineViewModel
@using System.Text.Json
@{ ViewData["Title"] = "Расписание"; var manager = (bool)ViewBag.Manager; var services = (List<ServiceItem>)ViewBag.Services;
   var minutes = (Model.DayEnd - Model.DayStart).TotalMinutes; var height = (int)(minutes * 2); var columns = Math.Max(1,Model.Barbers.Count); var json = new JsonSerializerOptions(JsonSerializerDefaults.Web); }
<div class="section-heading"><div><span class="tiny-caps text-primary">КАЖДОМУ ВИЗИТУ — СВОЁ МЕСТО</span><h1>Расписание</h1><p class="muted">@(manager ? "Управляйте заявками и временем команды." : "Ваши клиенты и личная смена. Номера телефонов маскируются.")</p></div>
@if (manager) { <button class="btn btn-primary rounded-pill" data-bs-toggle="modal" data-bs-target="#quickBooking"><i class="bi bi-plus-lg me-2"></i>Добавить запись</button> }</div>
<div class="calendar-card"><div class="calendar-toolbar"><form method="get" class="date-picker-form"><a class="btn btn-light" href="?date=@Model.SelectedDate.AddDays(-1).ToString("yyyy-MM-dd")" aria-label="Предыдущий день"><i class="bi bi-chevron-left"></i></a><input type="date" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" class="form-control" aria-label="Дата расписания" /><button class="btn btn-outline-primary rounded-pill">Показать</button><a class="btn btn-light" href="?date=@Model.SelectedDate.AddDays(1).ToString("yyyy-MM-dd")" aria-label="Следующий день"><i class="bi bi-chevron-right"></i></a></form><span class="tiny-caps">@Model.SelectedDate.ToString("dddd, dd MMMM")</span><span class="small muted">@Model.Appointments.Count визитов</span></div>
@if (Model.Barbers.Count == 0) { <div class="empty-state border-0"><i class="bi bi-scissors"></i><h2>Пока нет доступных мастеров</h2><p>Владелец может добавить мастера и настроить смену.</p></div> }
else { <div class="timeline-scroll"><div class="timeline-grid" style="--columns:@columns"><div class="timeline-label">ВРЕМЯ</div>@foreach(var barber in Model.Barbers) { <div class="timeline-barber-head"><img src="/images/barber.svg" alt="" /><div><strong>@barber.FullName</strong><small>@barber.Title</small></div></div> }
<div class="time-labels" style="height:@(height)px">@for(var time = Model.DayStart; time < Model.DayEnd; time += TimeSpan.FromHours(1)) { <span class="time-label" style="top:@((int)((time-Model.DayStart).TotalMinutes*2))px">@time.ToString(@"hh\:mm")</span> }</div>
@foreach(var barber in Model.Barbers) { <div class="barber-column" style="height:@(height)px">@foreach(var a in Model.Appointments.Where(a=>a.BarberId==barber.Id)) { var top=(int)((a.StartTime-Model.DayStart).TotalMinutes*2); var blockHeight=Math.Max(38,(int)((a.EndTime-a.StartTime).TotalMinutes*2)-5); <button class="appointment-block @(blockHeight < 90 ? "compact" : "")" style="top:@(top)px;height:@(blockHeight)px" data-appointment="@JsonSerializer.Serialize(a,json)" aria-label="@a.StartTime.ToString(@"hh\:mm") @a.ClientName, @a.ServiceName"><span class="slot-time">@a.TimeRange</span><strong>@a.ClientName</strong><small>@a.ServiceName</small><small>@StatusText.Name(a.Status)</small></button> }</div> }</div></div> }</div>
<div class="inline-notice"><i class="bi bi-shield-check me-2"></i> Все изменения повторно проверяются сервером. Пересечения, прошедшие слоты и недоступные смены не сохранятся.</div>
<div class="modal fade" id="appointmentDetails" tabindex="-1" aria-labelledby="appointmentTitle"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><div><span class="tiny-caps text-primary" data-detail="bookingCode"></span><h2 class="modal-title mt-2" id="appointmentTitle" data-detail="clientName"></h2></div><button class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button></div><div class="modal-body"><dl class="row g-2"><dt class="col-4">Телефон</dt><dd class="col-8" data-detail="clientPhone"></dd><dt class="col-4">Услуга</dt><dd class="col-8" data-detail="serviceName"></dd><dt class="col-4">Мастер</dt><dd class="col-8" data-detail="barberName"></dd><dt class="col-4">Время</dt><dd class="col-8" data-detail="timeRange"></dd><dt class="col-4">Комментарий</dt><dd class="col-8 text-wrap-anywhere" data-detail="notes"></dd></dl>
<form asp-action="UpdateStatus" method="post" data-status-form><input name="id" type="hidden" /><input name="version" type="hidden" /><input name="returnUrl" type="hidden" value="@Context.Request.Path@Context.Request.QueryString" /><div class="row-actions mt-4">
@if (manager) { <button name="status" value="1" class="btn btn-primary rounded-pill" data-transition="1">Подтвердить</button><button name="status" value="3" class="btn btn-outline-danger rounded-pill" data-transition="3">Отменить</button> }
<button name="status" value="2" class="btn btn-outline-success rounded-pill" data-transition="2">Завершить</button><button name="status" value="4" class="btn btn-outline-secondary rounded-pill" data-transition="4">Неявка</button></div></form>
@if (manager) { <details class="mt-4" data-reschedule-section><summary class="small">Перенести запись</summary><form asp-action="Reschedule" method="post" data-reschedule-form><input name="id" type="hidden" /><input name="version" type="hidden" /><label>Новая дата<input name="date" type="date" class="form-control" required /></label><label>Время начала<input name="time" type="time" class="form-control" required step="1800" /></label><button class="btn btn-outline-primary rounded-pill mt-3">Перенести запись</button></form></details> }
</div></div></div></div>
@if(manager) { <div class="modal fade" id="quickBooking" tabindex="-1" aria-labelledby="quickTitle"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h2 class="modal-title" id="quickTitle">Запись от администратора</h2><button class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button></div><form asp-action="QuickCreate" method="post" id="quick-form"><div class="modal-body"><label>Услуга<select name="ServiceId" class="form-select" required>@foreach(var service in services) { <option value="@service.Id">@service.Name · @service.Price.ToString("N0") сом</option> }</select></label><label>Мастер<select name="BarberId" class="form-select" required>@foreach(var barber in Model.Barbers) { <option value="@barber.Id">@barber.FullName</option> }</select></label><label>Дата<input name="Date" type="date" class="form-control" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" required /></label><label>Свободное время<select name="TimeSlot" class="form-select" required><option value="">Выберите параметры записи</option></select></label><small class="muted" data-quick-status></small><label>Имя клиента<input name="ClientName" class="form-control" required minlength="2" maxlength="100" /></label><label>Телефон<input name="ClientPhone" class="form-control" type="tel" placeholder="+996 …" required maxlength="30" /></label><label>Комментарий<textarea name="Notes" class="form-control" maxlength="300"></textarea></label></div><div class="modal-footer"><button class="btn btn-primary rounded-pill" type="submit">Создать запись</button></div></form></div></div></div> }
@section Scripts { <script src="~/js/timeline.js" asp-append-version="true"></script> }
