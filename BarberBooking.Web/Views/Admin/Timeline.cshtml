@model BarberBooking.Web.Models.ScheduleTimelineViewModel
@using BarberBooking.Web.Models
@{
    ViewData["Title"] = "Appointments - Расписание барбершопа";
    var services = ViewBag.Services as List<ServiceItem> ?? new List<ServiceItem>();
    var selectedDate = Model.SelectedDate;
    var dayStartHour = Model.DayStart.Hours; // 10
    var dayEndHour = Model.DayEnd.Hours;     // 21
    var totalHours = dayEndHour - dayStartHour; // 11
    var slotHeightPx = 80; // 1 час = 80px
}

<div class="container-fluid px-lg-4 py-3">
    <!-- Top Action Bar (Референс: "Appointments") -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div class="d-flex align-items-center gap-3">
            <h1 class="h2 fw-extrabold text-dark mb-0 tracking-tight">Appointments</h1>
            <div class="d-flex align-items-center bg-white border rounded-pill px-3 py-1 shadow-xs">
                <a href="@Url.Action("Timeline", new { date = selectedDate.AddDays(-1).ToString("yyyy-MM-dd") })" class="btn btn-sm btn-link text-dark p-0 me-2 text-decoration-none">
                    <i class="bi bi-chevron-left"></i>
                </a>
                <span class="fw-bold text-dark mx-2">
                    @selectedDate.ToString("d MMMM yyyy, dddd")
                </span>
                <a href="@Url.Action("Timeline", new { date = selectedDate.AddDays(1).ToString("yyyy-MM-dd") })" class="btn btn-sm btn-link text-dark p-0 ms-2 text-decoration-none">
                    <i class="bi bi-chevron-right"></i>
                </a>
            </div>
            @if (selectedDate.Date != DateTime.Today)
            {
                <a href="@Url.Action("Timeline", new { date = DateTime.Today.ToString("yyyy-MM-dd") })" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold">
                    Сегодня
                </a>
            }
        </div>

        <div class="d-flex align-items-center gap-2">
            <!-- Переключатель вкладок админки -->
            <div class="btn-group p-1 bg-white border rounded-pill shadow-xs" role="group">
                <a asp-action="Timeline" asp-route-date="@selectedDate.ToString("yyyy-MM-dd")" class="btn btn-sm btn-primary rounded-pill px-3 fw-semibold active">
                    <i class="bi bi-kanban me-1"></i> Таймлайн
                </a>
                <a asp-action="Appointments" class="btn btn-sm btn-light rounded-pill px-3 fw-semibold text-secondary">
                    <i class="bi bi-table me-1"></i> Таблица
                </a>
                <a asp-action="Dashboard" class="btn btn-sm btn-light rounded-pill px-3 fw-semibold text-secondary">
                    <i class="bi bi-graph-up me-1"></i> Аналитика
                </a>
            </div>

            <button type="button" class="btn btn-dark rounded-pill px-3 py-2 fw-semibold d-flex align-items-center gap-2 shadow-xs" data-bs-toggle="modal" data-bs-target="#newAppointmentModal">
                <i class="bi bi-plus-lg"></i>
                <span>Новая запись</span>
            </button>
        </div>
    </div>

    <!-- Timeline Grid Container -->
    <div class="timeline-wrapper" style="--master-count: @Model.Barbers.Count;">
        
        <!-- Header: Мастера по столбцам -->
        <div class="timeline-header">
            <div class="timeline-time-col-header">
                <i class="bi bi-clock"></i> Время
            </div>
            @foreach (var b in Model.Barbers)
            {
                var barberAppointments = Model.Appointments.Where(a => a.BarberId == b.Id).ToList();
                <div class="timeline-barber-col-header">
                    <img src="@b.AvatarUrl" alt="@b.FullName" class="timeline-barber-avatar" />
                    <div>
                        <div class="fw-bold text-dark lh-sm">@b.FullName</div>
                        <div class="small text-muted d-flex align-items-center gap-2">
                            <span>@b.Title</span>
                            <span class="badge bg-secondary-subtle text-secondary rounded-pill px-2">@barberAppointments.Count зап.</span>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Body: Сетка часов и карточки записей -->
        <div class="timeline-body">
            
            <!-- Левая колонка со шкалой времени -->
            <div class="timeline-time-col">
                @for (int hour = dayStartHour; hour <= dayEndHour; hour++)
                {
                    <div class="timeline-time-slot">
                        @($"{hour:00}:00")
                    </div>
                }
            </div>

            <!-- Колонки мастеров с карточками записей -->
            @foreach (var barber in Model.Barbers)
            {
                var barberApps = Model.Appointments.Where(a => a.BarberId == barber.Id).ToList();
                <div class="timeline-barber-col" style="height: @((totalHours + 1) * slotHeightPx)px;">
                    
                    @foreach (var app in barberApps)
                    {
                        // Расчет позиции карточки по вертикали
                        var startMinutesFromStart = (app.StartTime.Hours - dayStartHour) * 60 + app.StartTime.Minutes;
                        var topPx = (startMinutesFromStart / 60.0) * slotHeightPx;
                        
                        var durationMinutes = (app.EndTime - app.StartTime).TotalMinutes;
                        var heightPx = Math.Max(50, (durationMinutes / 60.0) * slotHeightPx - 6);

                        // Стиль цвета карточки
                        var cardColorClass = barber.BadgeColor switch
                        {
                            "#F59E0B" => "timeline-card-yellow",
                            "#06B6D4" => "timeline-card-cyan",
                            "#8B5CF6" => "timeline-card-purple",
                            "#10B981" => "timeline-card-emerald",
                            _ => "timeline-card-orange"
                        };

                        <div class="timeline-card @cardColorClass" 
                             style="top: @((int)topPx)px; height: @((int)heightPx)px;"
                             onclick="openAppointmentModal(@app.Id, '@app.BookingCode', '@app.ClientName', '@app.ClientPhone', '@app.ServiceName', '@barber.FullName', '@app.Date.ToString("dd.MM.yyyy")', '@app.TimeRange', '@app.Price.ToString("N0") сом', '@app.Status', '@(app.Notes ?? "")')">
                            
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="badge bg-white bg-opacity-75 text-dark rounded-pill px-2 py-0 fw-bold" style="font-size: 0.72rem;">
                                    @app.TimeRange
                                </span>
                                <span class="fw-bold opacity-75" style="font-size: 0.72rem;">@app.BookingCode</span>
                            </div>

                            <div class="fw-bold text-truncate" style="font-size: 0.82rem; line-height: 1.15;">@app.ClientName</div>
                            <div class="text-truncate opacity-85" style="font-size: 0.72rem; line-height: 1.15;">@app.ServiceName</div>
                        </div>
                    }

                </div>
            }

        </div>

    </div>
</div>

<!-- Модальное окно: Просмотр и управление выбранной записью -->
<div class="modal fade" id="appointmentDetailModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow-lg">
            <div class="modal-header border-bottom">
                <div>
                    <h5 class="modal-title fw-bold text-dark" id="modalBookingCode">Запись BRB-XXXX</h5>
                    <div class="small text-muted" id="modalDateTime">-</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted">Клиент:</span>
                    <span class="fw-bold text-dark" id="modalClientName">-</span>
                </div>
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted">Телефон:</span>
                    <a href="#" class="fw-bold text-primary text-decoration-none" id="modalClientPhone">-</a>
                </div>
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted">Услуга:</span>
                    <span class="fw-bold text-dark" id="modalService">-</span>
                </div>
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted">Мастер:</span>
                    <span class="fw-bold text-dark" id="modalBarber">-</span>
                </div>
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted">Стоимость:</span>
                    <span class="fw-bold text-dark fs-5" id="modalPrice">-</span>
                </div>
                <div class="py-2 border-bottom" id="modalNotesContainer">
                    <div class="text-muted small">Комментарий клиента:</div>
                    <div class="text-dark small" id="modalNotes">-</div>
                </div>

                <!-- Быстрая смена статуса -->
                <div class="mt-4">
                    <label class="form-label fw-bold small text-uppercase text-muted">Изменить статус</label>
                    <form method="post" asp-action="UpdateStatus" id="statusForm" class="d-flex gap-2">
                        <input type="hidden" name="id" id="modalAppointmentId" />
                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                        
                        <button type="submit" name="status" value="@AppointmentStatus.Confirmed" class="btn btn-sm btn-outline-primary rounded-pill flex-grow-1 fw-semibold">
                            <i class="bi bi-check2"></i> Подтвердить
                        </button>
                        <button type="submit" name="status" value="@AppointmentStatus.Completed" class="btn btn-sm btn-outline-success rounded-pill flex-grow-1 fw-semibold">
                            <i class="bi bi-check-all"></i> Выполнена
                        </button>
                        <button type="submit" name="status" value="@AppointmentStatus.Cancelled" class="btn btn-sm btn-outline-danger rounded-pill flex-grow-1 fw-semibold" onclick="return confirm('Отменить эту запись?');">
                            <i class="bi bi-x-circle"></i> Отменить
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Модальное окно: Новая запись от администратора -->
<div class="modal fade" id="newAppointmentModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow-lg">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold text-dark">Быстрая запись клиента</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-action="QuickCreate">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Мастер</label>
                        <select name="barberId" class="form-select rounded-3" required>
                            @foreach (var b in Model.Barbers)
                            {
                                <option value="@b.Id">@b.FullName (@b.Title)</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Услуга</label>
                        <select name="serviceId" class="form-select rounded-3" required>
                            @foreach (var s in services)
                            {
                                <option value="@s.Id">@s.Name — @s.Price.ToString("N0") сом (@s.DurationMinutes мин)</option>
                            }
                        </select>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-bold">Дата</label>
                            <input type="date" name="date" class="form-control rounded-3" value="@selectedDate.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-bold">Время начала</label>
                            <input type="time" name="timeSlot" class="form-control rounded-3" value="12:00" step="1800" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Имя клиента</label>
                        <input type="text" name="clientName" class="form-control rounded-3" placeholder="Адилет" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Телефон</label>
                        <input type="tel" name="clientPhone" class="form-control rounded-3" placeholder="+996 555 123-456" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Заметка / пожелание</label>
                        <input type="text" name="notes" class="form-control rounded-3" placeholder="Запись по телефону" />
                    </div>
                </div>
                <div class="modal-footer border-top p-3">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">Отмена</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">Записать клиента</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function openAppointmentModal(id, code, client, phone, service, barber, date, timeRange, price, status, notes) {
        document.getElementById('modalAppointmentId').value = id;
        document.getElementById('modalBookingCode').textContent = `Запись #${code}`;
        document.getElementById('modalDateTime').textContent = `${date} • ${timeRange}`;
        document.getElementById('modalClientName').textContent = client;
        
        const phoneEl = document.getElementById('modalClientPhone');
        phoneEl.textContent = phone;
        phoneEl.href = `tel:${phone}`;
        
        document.getElementById('modalService').textContent = service;
        document.getElementById('modalBarber').textContent = barber;
        document.getElementById('modalPrice').textContent = price;
        
        const notesContainer = document.getElementById('modalNotesContainer');
        if (notes && notes.trim().length > 0) {
            document.getElementById('modalNotes').textContent = notes;
            notesContainer.classList.remove('d-none');
        } else {
            notesContainer.classList.add('d-none');
        }

        const modal = new bootstrap.Modal(document.getElementById('appointmentDetailModal'));
        modal.show();
    }
</script>
}
