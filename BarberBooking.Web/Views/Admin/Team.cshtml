@model List<BarberBooking.Web.Controllers.TeamRow>
@{ ViewData["Title"]="Аккаунты и доступ"; var barbers=(List<Barber>)ViewBag.Barbers; string? password=ViewBag.OneTimePassword; }
<div class="section-heading"><div><span class="tiny-caps text-primary">КАЖДОМУ — СВОЙ ДОСТУП</span><h1>Аккаунты и роли</h1><p class="muted">Последние 200 аккаунтов. Сотрудникам — отдельный вход; клиент регистрируется самостоятельно.</p></div><button class="btn btn-primary rounded-pill" data-bs-toggle="modal" data-bs-target="#staffCreate">Добавить сотрудника <i class="bi bi-plus-lg ms-2"></i></button></div>
@if(password is not null) { <div class="password-reveal"><strong>Передайте временный пароль лично. Он показывается один раз:</strong><br /><code>@password</code><p class="small mb-0 mt-2">При входе потребуется задать новый пароль. Старые сеансы завершены.</p></div> }
<div class="table-card mt-3"><div class="table-responsive"><table class="table business-table"><thead><tr><th>Аккаунт</th><th>Роль</th><th>Состояние</th><th>Управление</th></tr></thead><tbody>@foreach(var u in Model) { <tr><td><strong>@u.Name</strong><br /><small>@u.Login</small></td><td><span class="role-tag">@u.Roles</span></td><td><span class="status-pill @(u.Active?"status-2":"status-3")">@(u.Active?"Активен":"Отключён")</span>@if(u.MustChangePassword) { <small class="d-block">Нужна смена пароля</small> }</td><td>@if(!u.Roles.Contains(Roles.Owner)) { <div class="row-actions"><form asp-action="ToggleUser" method="post" data-confirm="Изменить доступ к аккаунту?"><input name="id" value="@u.Id" type="hidden" /><button class="btn btn-light rounded-pill">@(u.Active?"Отключить":"Включить")</button></form><form asp-action="ResetUserPassword" method="post" data-confirm="Выдать новый временный пароль и завершить сеансы?"><input name="id" value="@u.Id" type="hidden" /><button class="btn btn-outline-secondary rounded-pill">Сбросить пароль</button></form></div> } else { <small>Владелец защищён от отключения</small> }</td></tr> }</tbody></table></div></div>
<div class="modal fade" id="staffCreate" tabindex="-1" aria-labelledby="staffTitle"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h2 class="modal-title" id="staffTitle">Новый сотрудник</h2><button class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button></div><form asp-action="CreateStaff" method="post"><div class="modal-body"><label>Имя<input name="DisplayName" class="form-control" required maxlength="100" /></label><label>Логин<input name="UserName" class="form-control" required pattern="[a-zA-Z0-9._-]{3,40}" maxlength="40" autocomplete="off" /></label><label>Временный пароль<input name="Password" type="password" class="form-control" required minlength="12" maxlength="128" autocomplete="new-password" /></label><small class="muted">12+ символов, с цифрами, строчными и заглавными буквами.</small><label>Роль<select name="Role" class="form-select"><option value="Reception">Ресепшен / администратор</option><option value="Barber">Барбер</option></select></label><label>Мастер для роли «Барбер»<select name="BarberId" class="form-select"><option value="">Не выбран</option>@foreach(var b in barbers) { <option value="@b.Id">@b.FullName</option> }</select></label></div><div class="modal-footer"><button class="btn btn-primary rounded-pill">Создать аккаунт</button></div></form></div></div></div>
