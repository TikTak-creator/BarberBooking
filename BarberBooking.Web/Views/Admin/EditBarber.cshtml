@model Barber
@{ ViewData["Title"]=Model.Id==0?"Новый мастер":"Редактировать мастера"; }
<div class="section-heading"><div><span class="tiny-caps text-primary">КОМАНДА</span><h1>@ViewData["Title"]</h1></div><a href="/admin/barbers" class="small">Назад к мастерам</a></div><section class="panel-card form-panel"><div asp-validation-summary="All" class="validation-summary"></div>
<form asp-action="EditBarber" method="post"><input asp-for="Id" type="hidden" /><div class="form-grid"><div><label asp-for="FullName">Имя мастера</label><input asp-for="FullName" class="form-control" required maxlength="100" /></div><div><label asp-for="Title">Специализация / должность</label><input asp-for="Title" class="form-control" required maxlength="100" /></div><div class="full"><label asp-for="Bio">О мастере</label><textarea asp-for="Bio" class="form-control" maxlength="500" rows="3"></textarea></div><div><label asp-for="WorkingDays">Рабочие дни через запятую</label><input asp-for="WorkingDays" class="form-control" required maxlength="50" /><small class="muted">0 — воскресенье, 1 — понедельник, …, 6 — суббота.</small></div><div><label asp-for="ExperienceYears">Стаж, лет</label><input asp-for="ExperienceYears" type="number" class="form-control" min="0" max="70" /></div><div><label asp-for="WorkStartTime">Начало смены</label><input asp-for="WorkStartTime" type="time" class="form-control" value="@Model.WorkStartTime.ToString(@"hh\:mm")" required /></div><div><label asp-for="WorkEndTime">Конец смены</label><input asp-for="WorkEndTime" type="time" class="form-control" value="@Model.WorkEndTime.ToString(@"hh\:mm")" required /></div><div><label asp-for="BadgeColor">Цвет карточки</label><input asp-for="BadgeColor" type="color" class="form-control" /></div><div class="d-flex align-items-end"><label class="check-label"><input asp-for="IsActive" /> Доступен для новых записей</label></div></div><div class="inline-notice">Изменение смены и архивирование не должны конфликтовать с будущими визитами. Такие изменения сервер отклонит.</div><button class="btn btn-primary rounded-pill">Сохранить мастера</button></form></section>
