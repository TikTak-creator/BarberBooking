@model List<TimeOff>
@{ ViewData["Title"]="Перерывы и выходные"; var barbers=(List<Barber>)ViewBag.Barbers; }
<div class="section-heading"><div><span class="tiny-caps text-primary">МЕСТО ДЛЯ ПАУЗЫ</span><h1>Перерывы и выходные</h1><p class="muted">Перерыв блокирует слоты. При пересечении с визитом сначала перенесите запись.</p></div></div>
<div class="panel-card mb-4"><form asp-action="AddTimeOff" method="post"><div class="form-grid"><div><label>Мастер<select name="barberId" class="form-select" required>@foreach(var b in barbers) { <option value="@b.Id">@b.FullName</option> }</select></label></div><div><label>Дата<input name="date" type="date" class="form-control" required /></label></div><div><label>С<input name="start" type="time" class="form-control" required /></label></div><div><label>До<input name="end" type="time" class="form-control" required /></label></div><div class="full"><label>Причина<input name="reason" class="form-control" maxlength="200" placeholder="Перерыв, отпуск, личное время" /></label></div></div><button class="btn btn-primary rounded-pill mt-4">Добавить перерыв</button></form></div>
<div class="table-card"><div class="table-responsive"><table class="table business-table"><thead><tr><th>Мастер</th><th>Дата</th><th>Время</th><th>Причина</th><th></th></tr></thead><tbody>@foreach(var t in Model) { <tr><td><strong>@t.Barber.FullName</strong></td><td>@t.Date.ToString("dd.MM.yyyy")</td><td>@t.StartTime.ToString(@"hh\:mm") – @t.EndTime.ToString(@"hh\:mm")</td><td>@t.Reason</td><td><form asp-action="RemoveTimeOff" method="post" data-confirm="Удалить перерыв и открыть свободное время?"><input name="id" value="@t.Id" type="hidden" /><button class="btn btn-light rounded-pill">Удалить</button></form></td></tr> }</tbody></table></div></div>
