@model ShopSettings
@{ ViewData["Title"]="Настройки салона"; }
<div class="section-heading"><div><span class="tiny-caps text-primary">ВАШ САЛОН, ВАШИ ПРАВИЛА</span><h1>Настройки</h1><p class="muted">Серверные пароли и ключи не передаются на эту страницу.</p></div></div><section class="panel-card form-panel"><div asp-validation-summary="All" class="validation-summary"></div>
<form asp-action="Settings" method="post"><h2>Салон и контакты</h2><div class="form-grid"><div><label asp-for="Name">Название</label><input asp-for="Name" class="form-control" required maxlength="100" /></div><div><label asp-for="Phone">Телефон салона</label><input asp-for="Phone" class="form-control" maxlength="40" /></div><div class="full"><label asp-for="Address">Адрес</label><input asp-for="Address" class="form-control" maxlength="200" /></div><div><label asp-for="TimeZoneId">Часовой пояс IANA</label><input asp-for="TimeZoneId" class="form-control" required maxlength="80" placeholder="Asia/Bishkek" /></div><div><label asp-for="BookingHorizonDays">На сколько дней вперёд</label><input asp-for="BookingHorizonDays" type="number" class="form-control" min="1" max="180" /></div><div><label asp-for="LeadMinutes">Минимум до начала, минут</label><input asp-for="LeadMinutes" type="number" class="form-control" min="0" max="240" /></div><div><label asp-for="CancellationLeadMinutes">Отмена не позднее чем за, минут</label><input asp-for="CancellationLeadMinutes" type="number" class="form-control" min="0" max="1440" /></div></div><label class="check-label mt-4"><input asp-for="OnlineBookingEnabled" /> Принимать онлайн-записи</label><label class="check-label mt-3"><input asp-for="AllowGuestBooking" /> Разрешить запись без аккаунта, с секретным гостевым талоном</label><p class="muted small">При выключенной гостевой записи клиент сначала входит в личный аккаунт.</p><hr class="my-4" /><h2>Почта аккаунтов</h2><p class="muted small">SMTP с STARTTLS, обычно порт 587. Нужны учётные данные вашего почтового сервиса. Встроенного SMS-провайдера нет.</p>
<div class="form-grid"><div><label asp-for="SmtpHost">SMTP-сервер</label><input asp-for="SmtpHost" class="form-control" maxlength="100" /></div><div><label asp-for="SmtpPort">Порт</label><input asp-for="SmtpPort" type="number" class="form-control" min="1" max="65535" /></div><div><label asp-for="SmtpUser">Пользователь SMTP</label><input asp-for="SmtpUser" class="form-control" maxlength="100" autocomplete="off" /></div><div><label asp-for="SmtpFrom">Email отправителя</label><input asp-for="SmtpFrom" type="email" class="form-control" maxlength="100" /></div><div class="full"><label for="smtpPassword">Новый пароль SMTP (пусто — оставить прежний)</label><input name="smtpPassword" id="smtpPassword" type="password" class="form-control" maxlength="500" autocomplete="new-password" /></div></div><button class="btn btn-primary rounded-pill mt-4">Сохранить настройки</button></form></section>
