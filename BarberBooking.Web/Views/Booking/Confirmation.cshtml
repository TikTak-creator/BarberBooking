@model BookingConfirmationViewModel
@{ ViewData["Title"] = "Талон записи"; string? key = ViewBag.GuestKey; bool canCancel = ViewBag.CanCancel; }
<section class="page-width account-page"><a href="/Account/MyBookings" class="back-link"><i class="bi bi-arrow-left"></i> Мои записи</a><div class="ticket-layout"><article class="ticket-card"><div class="ticket-heading"><i class="bi bi-ticket-perforated"></i><span class="tiny-caps">ВАШ ТАЛОН</span><span class="status-pill status-@((int)Model.Status)">@StatusText.Name(Model.Status)</span></div><h1>@Model.ServiceName</h1><p class="muted">@Model.BarberName</p><div class="ticket-date"><div><small>ДАТА ВИЗИТА</small><strong>@Model.Date.ToString("dd MMMM yyyy")</strong></div><div><small>ВРЕМЯ</small><strong>@Model.StartTime.ToString(@"hh\:mm") – @Model.EndTime.ToString(@"hh\:mm")</strong></div></div><dl class="ticket-details"><dt>Клиент</dt><dd>@Model.ClientName</dd><dt>Телефон</dt><dd>@Model.ClientPhone</dd><dt>Стоимость</dt><dd>@Model.Price.ToString("N2") сом</dd><dt>Код</dt><dd><code>@Model.BookingCode</code></dd></dl>
@if (key is not null) { <div class="recovery-box"><strong>Сохраните секретный ключ</strong><p class="small">Он показывается один раз. Вместе с кодом записи позволяет открыть талон с другого устройства. Никому не передавайте.</p><code class="text-break">@key</code></div> }
<button type="button" class="btn btn-outline-dark rounded-pill d-print-none" data-print>Распечатать талон <i class="bi bi-printer ms-2"></i></button></article><aside class="panel-card ticket-aside"><h2>До встречи в салоне</h2><p class="muted">Время указано в часовом поясе салона. Если планы изменились, отмените запись заранее — освободите окно другому клиенту.</p>
@if (canCancel) { <form asp-action="Cancel" method="post" data-confirm="Отменить этот визит?"><input type="hidden" name="code" value="@Model.BookingCode" /><input type="hidden" name="version" value="@Model.Version" /><label for="reason">Причина отмены (необязательно)</label><input name="reason" id="reason" class="form-control" maxlength="200" /><button class="btn btn-outline-danger rounded-pill mt-3">Отменить запись</button></form> }
else { <p class="small muted">Онлайн-отмена недоступна для текущего состояния или до визита осталось мало времени. Свяжитесь с администратором.</p> }
<a href="/Booking" class="d-block mt-4">Записаться ещё раз <i class="bi bi-arrow-up-right"></i></a></aside></div></section>
