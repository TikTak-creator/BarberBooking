@model BarberBooking.Web.Models.BookingConfirmationViewModel
@{
    ViewData["Title"] = "Запись подтверждена";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 bg-white rounded-4 shadow-sm p-4 p-md-5 text-center position-relative overflow-hidden">
                <!-- Top success banner -->
                <div class="mb-4">
                    <div class="bg-success text-white rounded-circle d-inline-flex align-items-center justify-content-center shadow-sm mb-3" style="width: 72px; height: 72px;">
                        <i class="bi bi-check-lg fs-1"></i>
                    </div>
                    <h2 class="fw-extrabold text-dark mb-1">Вы успешно записаны!</h2>
                    <p class="text-secondary mb-0">Ждём вас в Bladez Barbershop</p>
                </div>

                <!-- Booking Code Card -->
                <div class="bg-light p-3 rounded-3 border mb-4">
                    <div class="small text-muted text-uppercase fw-bold tracking-wider mb-1">Номер вашей брони</div>
                    <div class="display-6 fw-extrabold text-primary tracking-tight">@Model.BookingCode</div>
                    <div class="small text-secondary mt-1">Сохраните этот код для проверки или отмены брони</div>
                </div>

                <!-- Appointment details -->
                <div class="text-start mb-4">
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted"><i class="bi bi-person me-2"></i> Клиент:</span>
                        <span class="fw-bold text-dark">@Model.ClientName</span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted"><i class="bi bi-telephone me-2"></i> Телефон:</span>
                        <span class="fw-semibold text-dark">@Model.ClientPhone</span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted"><i class="bi bi-scissors me-2"></i> Услуга:</span>
                        <span class="fw-bold text-dark">@Model.ServiceName</span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted"><i class="bi bi-person-badge me-2"></i> Барбер:</span>
                        <span class="fw-bold text-primary">@Model.BarberName</span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted"><i class="bi bi-calendar3 me-2"></i> Дата:</span>
                        <span class="fw-bold text-dark">@Model.Date.ToString("dd MMMM yyyy (dddd)")</span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted"><i class="bi bi-clock me-2"></i> Время визита:</span>
                        <span class="fw-bold text-dark">@Model.StartTime.ToString(@"hh\:mm") – @Model.EndTime.ToString(@"hh\:mm")</span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted"><i class="bi bi-cash me-2"></i> Стоимость:</span>
                        <span class="fs-5 fw-extrabold text-dark">@Model.Price.ToString("N0") сом</span>
                    </div>
                    <div class="d-flex justify-content-between py-2">
                        <span class="text-muted"><i class="bi bi-geo-alt me-2"></i> Адрес:</span>
                        <span class="fw-semibold text-dark">Бишкек, ул. Токтогула, 125/1</span>
                    </div>
                </div>

                <!-- Action buttons -->
                <div class="d-grid gap-2">
                    <a asp-controller="Booking" asp-action="Track" asp-route-code="@Model.BookingCode" class="btn btn-outline-dark rounded-pill fw-semibold py-2">
                        <i class="bi bi-clock-history me-1"></i> Проверить статус / Отменить
                    </a>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-link text-decoration-none text-muted">
                        Вернуться на главную
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
