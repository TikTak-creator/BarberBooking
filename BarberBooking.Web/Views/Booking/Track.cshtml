@{ ViewData["Title"] = "Найти талон"; }
<section class="auth-card standalone"><span class="tiny-caps text-primary">ГОСТЕВОЙ ТАЛОН</span><h1>Ваша запись</h1><p class="muted">Для гостевой записи нужны код и секретный ключ из талона. Один номер телефона не даёт доступа к данным.</p><div asp-validation-summary="All" class="validation-summary"></div>
<form asp-action="Track" method="post"><label for="code">Код записи</label><input id="code" name="code" class="form-control" placeholder="BRB-…" required maxlength="20" autocomplete="off" /><label for="key">Секретный ключ</label><input id="key" name="key" type="password" class="form-control" required maxlength="100" autocomplete="off" /><button class="btn btn-primary rounded-pill w-100 mt-4">Открыть талон <i class="bi bi-arrow-right ms-2"></i></button></form>
<p class="auth-bottom">Записывались через аккаунт? <a href="/Account/MyBookings">Мои записи</a></p></section>
