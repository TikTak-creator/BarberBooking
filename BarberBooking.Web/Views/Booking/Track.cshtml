@model List<BarberBooking.Web.Models.Appointment>
@{
    ViewData["Title"] = "Поиск и отслеживание записи";
    var searchCode = ViewBag.SearchCode as string;
    var searchPhone = ViewBag.SearchPhone as string;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 bg-white rounded-4 shadow-sm p-4 p-md-5 mb-4">
                <h2 class="h3 fw-extrabold text-dark mb-2">Найти запись</h2>
                <p class="text-secondary small mb-4">Введите номер брони (например, BRB-1011) или ваш номер телефона, указанный при записи</p>

                <form method="get" asp-controller="Booking" asp-action="Track" class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Номер брони</label>
                        <input type="text" name="code" value="@searchCode" class="form-control rounded-3" placeholder="BRB-XXXX" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Или номер телефона</label>
                        <input type="text" name="phone" value="@searchPhone" class="form-control rounded-3" placeholder="+996 555 123-456" />
                    </div>
                    <div class="col-12 text-end">
                        <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">
                            <i class="bi bi-search me-1"></i> Найти запись
                        </button>
                    </div>
                </form>
            </div>

            <!-- Results -->
            @if (Model != null && Model.Any())
            {
                <h4 class="fw-bold text-dark mb-3">Найденные записи (@Model.Count)</h4>
                <div class="d-flex flex-column gap-3">
                    @foreach (var app in Model)
                    {
                        <div class="card border rounded-4 bg-white shadow-xs p-4">
                            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 pb-3 border-bottom mb-3">
                                <div class="d-flex align-items-center gap-3">
                                    <span class="badge bg-light text-primary border fs-6 fw-extrabold px-3 py-2 rounded-pill">
                                        @app.BookingCode
                                    </span>
                                    <div>
                                        <h5 class="fw-bold text-dark mb-0">@app.Service.Name</h5>
                                        <span class="text-muted small">Мастер: <strong class="text-dark">@app.Barber.FullName</strong></span>
                                    </div>
                                </div>
                                <div>
                                    @switch (app.Status)
                                    {
                                        case BarberBooking.Web.Models.AppointmentStatus.Pending:
                                            <span class="badge bg-warning text-dark px-3 py-2 rounded-pill">Ожидает подтверждения</span>
                                            break;
                                        case BarberBooking.Web.Models.AppointmentStatus.Confirmed:
                                            <span class="badge bg-primary text-white px-3 py-2 rounded-pill">Подтверждена</span>
                                            break;
                                        case BarberBooking.Web.Models.AppointmentStatus.Completed:
                                            <span class="badge bg-success text-white px-3 py-2 rounded-pill">Выполнена</span>
                                            break;
                                        case BarberBooking.Web.Models.AppointmentStatus.Cancelled:
                                            <span class="badge bg-danger text-white px-3 py-2 rounded-pill">Отменена</span>
                                            break;
                                    }
                                </div>
                            </div>

                            <div class="row g-3 small text-secondary mb-3">
                                <div class="col-sm-6 col-md-3">
                                    <div class="text-muted">Дата:</div>
                                    <div class="fw-bold text-dark">@app.AppointmentDate.ToString("dd.MM.yyyy")</div>
                                </div>
                                <div class="col-sm-6 col-md-3">
                                    <div class="text-muted">Время:</div>
                                    <div class="fw-bold text-dark">@app.StartTime.ToString(@"hh\:mm") – @app.EndTime.ToString(@"hh\:mm")</div>
                                </div>
                                <div class="col-sm-6 col-md-3">
                                    <div class="text-muted">Клиент:</div>
                                    <div class="fw-bold text-dark">@app.ClientName</div>
                                </div>
                                <div class="col-sm-6 col-md-3">
                                    <div class="text-muted">Стоимость:</div>
                                    <div class="fw-bold text-dark">@app.Price.ToString("N0") сом</div>
                                </div>
                            </div>

                            @if (app.Status != BarberBooking.Web.Models.AppointmentStatus.Cancelled && app.Status != BarberBooking.Web.Models.AppointmentStatus.Completed)
                            {
                                <div class="pt-2 border-top d-flex justify-content-end">
                                    <form method="post" asp-controller="Booking" asp-action="Cancel" onsubmit="return confirm('Вы уверены, что хотите отменить запись?');">
                                        <input type="hidden" name="code" value="@app.BookingCode" />
                                        <input type="hidden" name="reason" value="Отменено пользователем через сайт" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-semibold">
                                            <i class="bi bi-x-circle me-1"></i> Отменить эту запись
                                        </button>
                                    </form>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(searchCode) || !string.IsNullOrWhiteSpace(searchPhone))
            {
                <div class="alert alert-info rounded-4 text-center py-4">
                    <i class="bi bi-info-circle fs-3 d-block mb-2"></i>
                    <h5 class="fw-bold">Записей не найдено</h5>
                    <p class="text-muted small mb-0">Проверьте правильность кода бронирования или номера телефона.</p>
                </div>
            }
        </div>
    </div>
</div>
