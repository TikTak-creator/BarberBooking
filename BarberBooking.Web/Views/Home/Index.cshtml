@{ ViewData["Title"] = "Ваш стиль. Ваше время."; var shop = (ShopSettings)ViewBag.Shop; var barbers = (List<Barber>)ViewBag.Barbers; var services = (List<ServiceItem>)ViewBag.Services; }
<section class="hero-section"><div class="page-width hero-grid"><div class="hero-copy">
<div class="eyebrow-pill"><span class="live-dot"></span> Ваше время — в надёжных руках</div>
<h1>Идеальный стиль.<br /><span>Без лишних ожиданий.</span></h1>
<p class="hero-description">Выберите услугу, найдите своего мастера и забронируйте удобное время. Всё остальное начинается с хорошей стрижки.</p>
<div class="hero-actions"><a href="/Booking" class="btn btn-primary btn-lg rounded-pill">Записаться онлайн <i class="bi bi-arrow-up-right ms-3"></i></a><a href="#services" class="btn btn-outline-dark btn-lg rounded-pill">Посмотреть услуги</a></div>
<div class="hero-proof"><span><i class="bi bi-shield-check"></i> Личный талон</span><span><i class="bi bi-calendar-check"></i> Актуальные слоты</span><span><i class="bi bi-person-check"></i> Ваш мастер</span></div>
</div><div class="hero-workspace" aria-label="Как устроена запись"><div class="workspace-top"><span class="tiny-caps">BLADEZ / BOOKING</span><span class="workspace-badge">В вашем ритме</span></div>
<div class="hero-scissors"><i class="bi bi-scissors"></i></div><h2>У хорошего стиля<br />есть своё время.</h2>
<div class="booking-steps"><div><span>01</span><strong>Услуга</strong><small>Выберите свой уход</small></div><div><span>02</span><strong>Мастер и время</strong><small>Найдите свободный слот</small></div><div><span>03</span><strong>Всё готово</strong><small>Талон в личном кабинете</small></div></div>
<div class="hero-float"><span class="float-icon"><i class="bi bi-clock-history"></i></span><div><strong>Меньше звонков. Больше дела.</strong><small>Запись доступна в любое время суток</small></div><i class="bi bi-arrow-up-right"></i></div>
</div></div></section>
@if (!shop.OnlineBookingEnabled) { <div class="page-width"><div class="alert alert-info">Онлайн-запись временно приостановлена. Свяжитесь с салоном: @shop.Phone</div></div> }
<section class="section-space" id="services"><div class="page-width"><div class="section-heading"><div><span class="tiny-caps text-primary">ПОД ВАШ ОБРАЗ</span><h2>Услуги без лишнего</h2></div><span class="muted">Актуальные цены · сом (KGS)</span></div>
<div class="service-grid">@foreach (var service in services) { <article class="service-card"><span class="service-icon"><i class="bi bi-scissors"></i></span><span class="duration"><i class="bi bi-clock"></i> @service.DurationMinutes мин</span><h3>@service.Name</h3><p>@service.Description</p><div class="service-bottom"><strong>@service.Price.ToString("N0") <small>сом</small></strong><a href="/Booking?serviceId=@service.Id" class="round-arrow" aria-label="Выбрать @service.Name"><i class="bi bi-arrow-up-right"></i></a></div></article> }</div>
@if (services.Count == 0) { <div class="empty-state"><i class="bi bi-tags"></i><h3>Каталог готовится</h3><p>Скоро здесь появятся услуги и цены салона.</p></div> }
</div></section>
<section class="section-space team-section"><div class="page-width"><div class="section-heading"><div><span class="tiny-caps text-primary">КОМАНДА</span><h2>Найдите своего мастера</h2></div><p class="muted">Смена и доступность учитываются при записи.</p></div><div class="barber-grid">
@foreach (var barber in barbers) { <article class="barber-card"><div class="barber-portrait"><img src="/images/barber.svg" alt="" /><span class="barber-number">@((barbers.IndexOf(barber) + 1).ToString("00"))</span></div><h3>@barber.FullName</h3><span class="text-primary small fw-semibold">@barber.Title</span><p>@barber.Bio</p><a href="/Booking?barberId=@barber.Id" class="btn btn-outline-dark rounded-pill w-100">Выбрать мастера <i class="bi bi-arrow-up-right ms-2"></i></a></article> }
</div></div></section>
<section class="page-width closing-card"><span class="tiny-caps">СЛЕДУЮЩИЙ ВИЗИТ НАЧИНАЕТСЯ ЗДЕСЬ</span><h2>Ваш образ.<br />Ваше время.</h2><a href="/Booking" class="btn btn-light rounded-pill px-4 py-3">Найти удобное время <i class="bi bi-arrow-up-right ms-3"></i></a></section>
