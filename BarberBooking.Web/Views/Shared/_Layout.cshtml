<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Bladez Barbershop</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 & Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light text-dark">
    <!-- Navbar -->
    <header class="sticky-top bg-white border-bottom shadow-xs">
        <nav class="navbar navbar-expand-lg navbar-light py-2">
            <div class="container-fluid px-lg-4">
                <a class="navbar-brand d-flex align-items-center gap-2 fw-bold" asp-controller="Home" asp-action="Index">
                    <span class="brand-icon d-flex align-items-center justify-content-center bg-dark text-white rounded-3 p-2">
                        <i class="bi bi-scissors fs-5"></i>
                    </span>
                    <span class="fs-4 tracking-tight">Bladez<span class="text-primary">.</span></span>
                </a>
                
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3 gap-1">
                        <li class="nav-item">
                            <a class="nav-link px-3 fw-semibold text-secondary" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house me-1"></i> Главная
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 fw-semibold text-secondary" asp-controller="Booking" asp-action="Index">
                                <i class="bi bi-calendar2-check me-1"></i> Запись онлайн
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 fw-semibold text-secondary" asp-controller="Booking" asp-action="Track">
                                <i class="bi bi-search me-1"></i> Найти бронь
                            </a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        <a asp-controller="Admin" asp-action="Timeline" class="btn btn-outline-dark d-flex align-items-center gap-2 px-3 fw-semibold rounded-pill">
                            <i class="bi bi-kanban"></i>
                            <span>Расписание (Админ)</span>
                            <span class="badge bg-primary text-white rounded-pill px-2">Календарь</span>
                        </a>
                        <a asp-controller="Booking" asp-action="Index" class="btn btn-primary d-flex align-items-center gap-2 px-4 fw-semibold rounded-pill shadow-sm">
                            <i class="bi bi-plus-circle"></i>
                            <span>Записаться</span>
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Alerts Container -->
    <div class="container-fluid px-lg-4 mt-3">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 rounded-3 shadow-xs" role="alert">
                <i class="bi bi-check-circle-fill fs-5"></i>
                <div>@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 rounded-3 shadow-xs" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                <div>@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
            </div>
        }
    </div>

    <!-- Main Content -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-white border-top py-4 mt-5">
        <div class="container-fluid px-lg-4 d-flex flex-column flex-md-row justify-content-between align-items-center gap-3 text-muted small">
            <div class="d-flex align-items-center gap-2">
                <span class="fw-bold text-dark">Bladez Barbershop</span> &copy; @DateTime.Now.Year. Все права защищены.
            </div>
            <div class="d-flex gap-4">
                <span><i class="bi bi-geo-alt-fill text-danger me-1"></i> Бишкек, ул. Токтогула, 125/1</span>
                <span><i class="bi bi-telephone-fill text-success me-1"></i> +996 555 778-899</span>
                <span><i class="bi bi-clock-fill text-primary me-1"></i> 10:00 – 21:00 ежедневно</span>
            </div>
        </div>
    </footer>

    <!-- Bootstrap Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
