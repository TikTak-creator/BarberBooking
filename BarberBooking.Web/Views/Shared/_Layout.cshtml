@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery Antiforgery
@inject BarberBooking.Web.Services.ShopClock ShopClock
@{
    var shop = await ShopClock.SettingsAsync();
    var admin = Context.Request.Path.StartsWithSegments("/admin");
    var manager = User.IsInRole(Roles.Owner) || User.IsInRole(Roles.Reception);
    var staff = manager || User.IsInRole(Roles.Barber);
    var token = Antiforgery.GetAndStoreTokens(Context).RequestToken;
}
<!doctype html><html lang="ru"><head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="csrf-token" content="@token" /><meta name="color-scheme" content="light" />
<title>@ViewData["Title"] · @shop.Name</title>
<link rel="icon" href="~/images/bladez.svg" type="image/svg+xml" />
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/business.css" asp-append-version="true" />
</head><body class="@(admin ? "admin-body" : "public-body")">
<a href="#content" class="skip-link">К содержимому</a>
<header class="topbar"><nav class="topbar-inner" aria-label="Главная навигация">
<a class="brand" href="/"><span class="brand-square"><i class="bi bi-scissors"></i></span><span>@shop.Name<span class="brand-dot">.</span></span></a>
<button class="nav-toggle" aria-label="Открыть меню" aria-expanded="false" data-toggle-nav><i class="bi bi-list"></i></button>
<div class="top-nav" id="main-navigation">
<a href="/" class="@(Context.Request.Path == "/" ? "active" : "")"><i class="bi bi-house"></i> Главная</a>
<a href="/Booking"><i class="bi bi-calendar2-check"></i> Запись онлайн</a>
@if (User.Identity?.IsAuthenticated == true) { <a href="/Account/MyBookings"><i class="bi bi-ticket-perforated"></i> Мои записи</a> }
else { <a href="/Booking/Track"><i class="bi bi-search"></i> Найти талон</a> }
<div class="nav-spacer"></div>
@if (staff) { <a href="/admin/timeline" class="nav-outline"><i class="bi bi-kanban"></i> Рабочее пространство</a> }
@if (User.Identity?.IsAuthenticated == true)
{
    <a href="/Account/Profile" class="account-link"><i class="bi bi-person-circle"></i> @User.Identity.Name</a>
    <form asp-controller="Account" asp-action="Logout" method="post" class="inline-form"><button class="nav-icon" aria-label="Выйти"><i class="bi bi-box-arrow-right"></i></button></form>
}
else { <a href="/Account/Login" class="nav-outline">Войти <i class="bi bi-arrow-up-right"></i></a> }
<a href="/Booking" class="btn btn-primary rounded-pill px-4"><i class="bi bi-plus-lg me-2"></i>Записаться</a>
</div></nav></header>
@if (admin)
{
<div class="business-shell"><aside class="business-sidebar"><div class="sidebar-label">РАБОЧЕЕ ПРОСТРАНСТВО</div>
@if (manager) { <a href="/admin"><i class="bi bi-grid-1x2"></i> Обзор дня</a> }
<a href="/admin/timeline"><i class="bi bi-calendar-week"></i> Расписание</a><a href="/admin/appointments"><i class="bi bi-journal-text"></i> Журнал записей</a>
@if (manager) { <a href="/admin/time-off"><i class="bi bi-cup-hot"></i> Перерывы и выходные</a> }
@if (User.IsInRole(Roles.Owner))
{
<div class="sidebar-label mt-4">УПРАВЛЕНИЕ</div><a href="/admin/barbers"><i class="bi bi-scissors"></i> Мастера</a><a href="/admin/services"><i class="bi bi-tags"></i> Услуги и цены</a>
<a href="/admin/team"><i class="bi bi-people"></i> Аккаунты и доступ</a><a href="/admin/settings"><i class="bi bi-sliders2"></i> Настройки салона</a>
<a href="/admin/audit"><i class="bi bi-shield-check"></i> Журнал действий</a><a href="/admin/system"><i class="bi bi-hdd-network"></i> Состояние сервера</a>
}
<div class="sidebar-bottom"><span class="live-dot"></span> Личное рабочее пространство<br /><a href="/Account/Security"><i class="bi bi-lock"></i> Безопасность аккаунта</a></div>
</aside><main id="content" class="business-content"><partial name="_Alerts" />@RenderBody()</main></div>
}
else { <main id="content"><div class="page-width"><partial name="_Alerts" /></div>@RenderBody()</main> }
<footer class="site-footer"><div class="page-width footer-inner"><span><strong>@shop.Name<span class="brand-dot">.</span></strong> &copy; @DateTime.UtcNow.Year</span>
<span>@(string.IsNullOrWhiteSpace(shop.Address) ? "Адрес уточняется у администратора" : shop.Address)</span><a href="/Home/Privacy">Обработка данных</a><span>@shop.Phone</span></div></footer>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script><script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body></html>
